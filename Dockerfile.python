# ---- Stage 1: Build frontend ----
FROM node:20-alpine AS builder

WORKDIR /build

# Copy dependency files
COPY frontend/package*.json ./
RUN npm install

# Copy all source
COPY . .
RUN npm run build

# ---- Stage 2: Python backend ----
FROM python:3.11-slim AS python-backend

WORKDIR /app

COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY backend/ .

# ---- Stage 3: Node.js server + static frontend ----
FROM node:20-alpine AS runtime

WORKDIR /app

# Copy frontend build
COPY --from=builder /build/dist /app/frontend/dist
COPY --from=builder /build/public/analyze-mse /app/frontend/public/analyze-mse

# Copy Node.js server
COPY server/package*.json /app/server/
RUN cd /app/server && npm install --omit=dev
COPY server/ /app/server/

# Copy Python backend
COPY --from=python-backend /app /app/backend

RUN mkdir -p /app/server/projects

EXPOSE 3000

ENV NODE_ENV=production
ENV PORT=3000
ENV HOST=0.0.0.0

WORKDIR /app/server
CMD ["node", "src/index.js"]
